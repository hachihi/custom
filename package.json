{
  "name": "order-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Cổng tra cứu đơn hàng / ticket cho khách hàng (Odoo 14) - Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
